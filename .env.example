# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Ollama base URL on the machine running the playground (leave empty on machines without Ollama)
OLLAMA_URL=http://127.0.0.1:11434
# Where uploads, frames, logs and the SQLite database live
DATA_DIR=./data
# Label recorded on every run so latencies from different machines can be separated
HOST_NAME=
# Electricity price used for the local-model energy estimate
ENERGY_PRICE_PER_KWH=0.25
